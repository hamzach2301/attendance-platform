# Copy this file to .env for local use. Do not commit the real .env file.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection string from Supabase Dashboard → Connect → Session pooler.
# This is secret. Keep the actual value only in .env or your hosting dashboard.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Leave this unset for Supabase. Set false only for a local PostgreSQL database.
DATABASE_SSL=true

# Required in production: generate a long random value and keep it private.
AUTH_SECRET=replace-with-a-long-random-secret

# Require this optional code before a new teacher can create an account.
TEACHER_SIGNUP_CODE=

# For cloud deployment, set your public HTTPS URL. Leave blank for LAN mode.
PUBLIC_URL=

# Hotspot attendance protection.
# true: a student must have the same public IP as the teacher who started the session.
# false: local development only; change this to true in cloud deployment settings.
REQUIRE_HOTSPOT_IP_MATCH=false
# 0 for a direct custom VPS. Render/Heroku/Vercel route requests through one
# trusted proxy, so use 1 only when users cannot directly reach your Node app.
TRUST_PROXY_HOPS=1

# Optional SMTP email reporting.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Attendance Reports <attendance@example.com>"
